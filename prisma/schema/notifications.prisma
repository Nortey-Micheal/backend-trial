model Notificaion {
  id         String    @id @default(uuid())
  user_id    String
  type       String    @db.VarChar(80)
  title      String    @db.VarChar(150)
  message    String
  data       Json?     @db.JsonB
  read_at    DateTime?
  created_at DateTime?

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id, created_at])
}
