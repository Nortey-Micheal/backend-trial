model User {
  id               String  @id @default(uuid())
  first_name       String
  middle_name      String?
  last_name        String
  email            String?
  email_normalized String? @unique
  phone            String?
  phone_normalized String? @unique
  password         String

  status                    Status    @default(PENDING_VERIFICATION)
  email_verified_at         DateTime?
  phone_verified_at         DateTime?
  last_login_at             DateTime?
  verification_code         String?
  verification_code_expires DateTime?
  createdAt                 DateTime  @default(now())
  updateAt                  DateTime  @updatedAt

  roleAssignmentsCreated User_Roles[] @relation("RoleAssignedBy")

  user_roles            User_Roles[]
  session               Session[]
  kycCases              Kyc_Case[]
  transactionLimits     Transaction_Limit[]
  auditLogs             Audit_Log[]
  reviewCases           Review_Case[]
  idempotencyKeys       Idempotency_Keys[]
  notificaions          Notificaion[]
  reconciliationRuns    Reconciliation_Run[]
  initiatedTransactions Transaction[]        @relation("TransactionInitiator")
  customer              Customer?
}

enum Status {
  PENDING_VERIFICATION
  ACTIVE
  LOCKED
  DEACTIVATED
}

model Roles {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  created_at  DateTime @default(now())

  user_roles User_Roles[]
}

model User_Roles {
  user_id     String
  role_id     String
  assigned_by String?
  assigned_at DateTime @default(now())

  user       User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role       Roles @relation(fields: [role_id], references: [id], onDelete: Cascade)
  assignedBy User? @relation("RoleAssignedBy", fields: [assigned_by], references: [id])

  @@id([user_id, role_id])
}
