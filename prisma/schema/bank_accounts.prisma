model Bank_Account {
  id             String         @id @default(uuid())
  account_number String         @unique
  account        AccountType
  currency_code  String         @db.VarChar(3)
  status         Account_Status
  opened_at      DateTime?
  closed_at      DateTime?
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  accountHolders                  Account_Holder[]
  ledgerAccounts                  Ledger_Account[]
  outgoing_transactions           Transaction[]                @relation("TransactionSource")
  incoming_transactions           Transaction[]                @relation("TransactionDestination")
  accountBalanceProjections       Account_Balance_Projection[]
  accountHolds                    Account_Hold[]
  scheduledTransfersAsSource      Scheduled_Transfer[]         @relation("TransferSourceAccount")
  scheduledTransfersAsDestination Scheduled_Transfer[]         @relation("TransferDestinationAccount")
  ledgerPostings                  Ledger_Postings[]
  beneficiaries                   Beneficiary[]
}

model Account_Holder {
  id                String                      @id @default(uuid())
  customer_id       String
  account_id        String
  relationship_type Account_Holder_Relationship
  can_view          Boolean                     @default(true)
  can_transact      Boolean                     @default(true)
  started_at        DateTime
  ended_at          DateTime?

  customer Customer     @relation(fields: [customer_id], references: [id])
  account  Bank_Account @relation(fields: [account_id], references: [id])

  @@unique([account_id, customer_id])
  @@index([customer_id])
}

enum Account_Holder_Relationship {
  OWNER
  JOINT_OWNER
  AUTHORIZED_SIGNATORY
}

enum Account_Status {
  PENDING_VERIFICATION
  ACTIVE
  FROZEN
  RESTRICTED
  CLOSED
}

enum AccountType {
  SAVINGS
  CURRENT
}
