model Transaction {
  id        String             @id @default(uuid())
  reference String             @unique
  type      Transaction_Type
  status    Transaction_Status @default(PENDING)

  initiated_by           String
  source_account_id      String?
  destination_account_id String?

  // Amounts stored in the currency's smallest unit.
  amount        BigInt
  currency_code String @db.VarChar(3)
  fee_amount    BigInt @default(0)

  description     String?
  idempotency_key Idempotency_Keys @relation(fields: [idempotency_Key_Id], references: [id])
  failure_code    String?
  failure_message String?

  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  completed_at DateTime?
  reversed_at  DateTime?

  initiatedBy        User               @relation("TransactionInitiator", fields: [initiated_by], references: [id])
  sourceAccount      Bank_Account?      @relation("TransactionSource", fields: [source_account_id], references: [id])
  destinationAccount Bank_Account?      @relation("TransactionDestination", fields: [destination_account_id], references: [id])
  journalEntries     Journal_Entries[]
  accountHolds       Account_Hold[]
  fraudAlerts        Fraud_Alert[]
  transferAttempts   Transfer_Attempt[]
  idempotency_Key_Id String             @unique

  @@index([source_account_id, created_at])
  @@index([destination_account_id, created_at])
  @@index([status, created_at])
  @@index([type, created_at])
}

enum Transaction_Status {
  PENDING
  PROCESSING
  POSTED
  FAILED
  CANCELLED
  REVERSED
}

enum Transaction_Type {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  FEE
  REVERSAL
  ADJUSTMENT
}
